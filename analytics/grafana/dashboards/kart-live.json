{
  "uid": "kart-live",
  "title": "Kart Live",
  "description": "Near-live overview of one kart, polled from TimescaleDB every second (about 1–2 s behind). The real-time view (≤ 250 ms) is the pit wall, which reads MQTT directly.",
  "tags": [
    "kart"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "refresh": "1s",
  "templating": {
    "list": [
      {
        "name": "kart",
        "label": "Kart",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT kart_id FROM sessions ORDER BY 1",
        "definition": "SELECT DISTINCT kart_id FROM sessions ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
