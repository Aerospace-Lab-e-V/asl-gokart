          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT max(value) AS value FROM (\n  SELECT DISTINCT ON (signal_id) value FROM samples\n  WHERE kart_id = '$kart' AND signal_id IN (401, 402, 403, 404) AND $__timeFilter(time)\n  ORDER BY signal_id, time DESC\n) t"
