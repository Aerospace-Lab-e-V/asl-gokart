{
  "uid": "kart-history",
  "title": "Kart Session History",
  "description": "One recorded session from the 1-second rollup (samples_1s). Pick a session in the table to jump to its time range.",
  "tags": [
    "kart"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "kart",
        "label": "Kart",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT kart_id FROM sessions ORDER BY 1",
        "definition": "SELECT DISTINCT kart_id FROM sessions ORDER BY 1",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": []
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT session_id::text AS __value,\n  to_char(started_at, 'YYYY-MM-DD HH24:MI') || ' UTC · ' || left(session_id::text, 8) AS __text\nFROM sessions WHERE kart_id = '$kart' ORDER BY started_at DESC",
        "refresh": 1,
        "sort": 0,
        "includeAll": false,
        "multi": false,
        "current": {},
        "options": [],
        "definition": "SELECT session_id::text AS __value,\n  to_char(started_at, 'YYYY-MM-DD HH24:MI') || ' UTC · ' || left(session_id::text, 8) AS __text\nFROM sessions WHERE kart_id = '$kart' ORDER BY started_at DESC"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "kart"
      ],
      "asDropdown": false,
      "title": "Kart",
      "includeVars": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Sessions (click a session to open it)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT session_id::text AS \"Session\", kart_id, started_at AS \"Started\", last_seen_at AS \"Last seen\",\n  to_char(last_seen_at - started_at, 'HH24:MI:SS') AS \"Duration\",\n  CASE WHEN online THEN 'online' ELSE 'offline' END AS \"Status\",\n  agent_version AS \"Agent\", schema_version AS \"Schema\",\n  (extract(epoch FROM started_at) * 1000)::bigint - 10000 AS from_ms,\n  (extract(epoch FROM last_seen_at) * 1000)::bigint + 10000 AS to_ms\nFROM sessions WHERE kart_id = '$kart' ORDER BY started_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "kart_id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "from_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "to_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Session"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open session",
                    "url": "/d/kart-history/kart-session-history?var-kart=${__data.fields.kart_id}&var-session=${__value.raw}&from=${__data.fields.from_ms}&to=${__data.fields.to_ms}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
