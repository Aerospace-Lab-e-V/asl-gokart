# Copy to .env (untracked) on the host and fill in. Only used by compose.prod.yml;
# compose.dev.yml has its own throwaway credentials.

POSTGRES_USER=
POSTGRES_PASSWORD=
# Password of the read-only grafana_ro database role
GRAFANA_DB_PASSWORD=
# Password of the read-only pit_api_ro database role (pit wall history)
PIT_API_DB_PASSWORD=

GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
