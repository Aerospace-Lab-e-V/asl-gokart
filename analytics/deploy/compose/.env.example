# Copy to /etc/kart-analytics/.env (mode 600) on the production host and fill in. Only used by compose.prod.yml;
# compose.dev.yml has its own throwaway credentials.

POSTGRES_USER=
POSTGRES_PASSWORD=
# Password of the read-only grafana_ro database role
GRAFANA_DB_PASSWORD=
# Password of the read-only pit_api_ro database role (pit wall history)
PIT_API_DB_PASSWORD=

GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
# The URL users open Grafana at, without a trailing slash, e.g. http://<VM_IP>:3000
GRAFANA_ROOT_URL=

# Lab SSO (deploy/vm/README.md, section 7). The realm URL, e.g. https://<SSO_HOST>/realms/<REALM>
OIDC_ISSUER=
# Grafana's client in the lab Keycloak (from the lab admins)
GRAFANA_OIDC_CLIENT_ID=
GRAFANA_OIDC_CLIENT_SECRET=

# Broker (ADR-0004). The admin user of Mosquitto's dynamic security plugin; only read on
# the broker's first start (it creates the plugin's file), and used by the enroll service.
MQTT_DYNSEC_ADMIN_PASSWORD=
# Broker login of ingest (user `ingest`). Part of a URL: use letters and digits only.
INGEST_MQTT_PASSWORD=
# Read-only broker login of the pit wall (user `pit-wall`); the same password goes into
# /etc/kart-analytics/pit-wall.config.json. Browsers see it, so it protects nothing on its own.
PIT_WALL_MQTT_PASSWORD=

# Optional overrides (defaults shown)
# PIT_WALL_CONFIG=/etc/kart-analytics/pit-wall.config.json
# DEVICE_CA_DIR=/etc/kart-analytics/device-ca
