# Copy to /etc/kart-analytics/.env (mode 600) on the production host and fill in. Only used by compose.prod.yml;
# compose.dev.yml has its own throwaway credentials.

POSTGRES_USER=
POSTGRES_PASSWORD=
# Password of the read-only grafana_ro database role
GRAFANA_DB_PASSWORD=
# Password of the read-only pit_api_ro database role (pit wall history)
PIT_API_DB_PASSWORD=

GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=

# Broker login of ingest; add the same user to /etc/kart-analytics/mosquitto.passwd.
# The password is part of a URL: use letters and digits only.
INGEST_MQTT_USER=ingest
INGEST_MQTT_PASSWORD=

# Optional overrides (defaults shown)
# MOSQUITTO_PASSWD=/etc/kart-analytics/mosquitto.passwd
# PIT_WALL_CONFIG=/etc/kart-analytics/pit-wall.config.json
