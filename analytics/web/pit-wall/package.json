{
    "name": "pit-wall",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Real-time live view of the kart for the pit crew",
    "scripts": {
        "gen": "buf generate && bun scripts/gen-catalog.ts && tsr generate",
        "predev": "bun run gen",
        "dev": "vite",
        "prebuild": "bun run gen",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "oxlint",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "tsc",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.16.0",
        "@tanstack/react-query": "^5.104.4",
        "@tanstack/react-router": "^1.170.45",
        "chart.js": "^4.5.1",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.59.0",
        "mqtt": "^5.16.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@bufbuild/buf": "^1.74.0",
        "@bufbuild/protoc-gen-es": "^2.16.0",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query-devtools": "^5.104.4",
        "@tanstack/react-router-devtools": "^1.167.2",
        "@tanstack/router-cli": "^1.167.45",
        "@tanstack/router-plugin": "^1.168.47",
        "@types/bun": "^1.4.3",
        "@types/leaflet": "^1.9.20",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "daisyui": "^5.7.50",
        "oxlint": "^1.88.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "yaml": "^2.9.1"
    }
}
