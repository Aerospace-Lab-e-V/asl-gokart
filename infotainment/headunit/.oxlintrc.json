{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["typescript", "react", "react-perf", "import", "jest"],
    "categories": {
        "correctness": "error",
        "suspicious": "warn"
    },
    "rules": {
        "react/react-in-jsx-scope": "off",
        "import/no-unassigned-import": [
            "warn",
            { "allow": ["**/*.css", "@/App", "./localization/i18n", "@testing-library/jest-dom"] }
        ],
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "warn",
        "react/purity": "warn",
        "react/set-state-in-effect": "warn"
    },
    "ignorePatterns": [".vite/**", "out/**", "coverage/**", "target/**"]
}
